{
  "manifest_version": 2,
  "name": "YouTube Music Downloader",
  "version": "0.3.2",
  "description": "Adds a ▼ MP3 download button to YouTube videos. Requires the yt-music-downloader desktop app to be installed and set up.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "activeTab"
  ],
  "browser_specific_settings": {
    "gecko": {
    "update_url": "https://github.com/sshcrack/yt-dlp-music-downloader/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}